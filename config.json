{
    "hostname": "archlinux",
    "bootloader": "Grub",
    "kernels": ["linux", "linux-lts"],
    "ntp": "true",
    "locale_config": {
        "sys_lang": "ru_RU",
        "sys_enc": "UTF-8",
        "kb_layout": "us"
    },
    "audio_config": {"audio":"pipewire"},
    "network_config": {"type": "nm"},
    "packages": ["git","curl","firefox","flatpak"],
    "custom_commands": [
	"echo ' -- [ARCH CFG] start installing ayugram, discord, spotify'",
        "echo ' -- [ARCH CFG] start serpantinum installator ...'",
        "curl -fsSL install.serpantinum.dev | sh"
    ]
}
