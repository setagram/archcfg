{
    "hostname": "archlinux",
    "bootloader": "Grub",
    "kernels": ["linux", "linux-lts"],
    "mirror_config": {
    "custom_servers": [
            {"url": "https://mirror.yandex.ru/archlinux/$repo/os/$arch"},
            {"url": "https://mirror.kamtv.ru/archlinux/$repo/os/$arch"},
            {"url": "https://mirror.kpfu.ru/archlinux/$repo/os/$arch"},
            {"url": "https://repository.su/archlinux/$repo/os/$arch"}
        ]
    },
    "disk_config": {
        "config_type": "pre_mounted_config",
        "mountpoint": "/mnt/archinstall"
    },
    "ntp": true,
    "locale_config": {
        "sys_lang": "ru_RU",
        "sys_enc": "UTF-8",
        "kb_layout": "us"
    },
    "audio_config": {"audio":"pipewire"},
    "network_config": {"type": "nm"},
    "packages": ["git","curl","wget","firefox","flatpak","neovim","nano"],
    "custom_commands": [
        "echo ' -- [ARCH CFG] fetching post-install.sh'",
        "USER=$(getent passwd 1000 | cut -d: -f1); curl -fsSL https://raw.githubusercontent.com/setagram/archcfg/main/post-install.sh -o /home/$USER/post-install.sh && chown $USER:$USER /home/$USER/post-install.sh && chmod +x /home/$USER/post-install.sh"
    ]
    
}
