{
    "hostname": "archlinux",
    "bootloader": "Grub",
    "kernels": ["linux", "linux-lts"],
    "mirror_config": {
    "custom_servers": [
            {"url": "https://mirror.yandex.ru/archlinux/$repo/os/$arch"},
            {"url": "https://mirror.kamtv.ru/archlinux/$repo/os/$arch"},
            {"url": "https://mirror.kpfu.ru/archlinux/$repo/os/$arch"},
            {"url": "https://repository.su/archlinux/$repo/os/$arch"}
        ]
    },
    "ntp": true,
    "locale_config": {
        "sys_lang": "ru_RU",
        "sys_enc": "UTF-8",
        "kb_layout": "us"
    },
    "audio_config": {"audio":"pipewire"},
    "network_config": {"type": "nm"},
    "packages": ["git","curl","wget","firefox","flatpak","neovim","nano"],
    "custom_commands": [
        "echo ' -- [ARCH CFG] installing Happ Proxy'",
        "wget https://github.com/Happ-proxy/happ-desktop/releases/latest/download/Happ.linux.x64.pkg.tar.zst -O /tmp/happ.pkg.tar.zst",
        "pacman -U --noconfirm /tmp/happ.pkg.tar.zst",
        "echo ' -- [ARCH CFG] start installing serpantinum'",
        "bash -c '$(curl -fsSL https://raw.githubusercontent.com/ilyamiro/serpantinum/master/install/install.sh)'"
    ]
}
